// Phase 2: reusable, lightweight cable organizer using the real
// native upstream openConnect receiver plate generated by Phase 1.
//
// The source file imports a *real* native receiving interface, without
// modifying its locking geometry. The decorative hook is original work.
//
// Run through generate_accessory.py so receiver_file is an actual path.
receiver_file = "";
stem_length_mm = 19.05;          // 0.75 in
stem_diameter_mm = 7.62;         // 0.30 in
lip_diameter_mm = 12.70;         // 0.50 in
lip_height_mm = 3.0;
$fn = 64;

assert(receiver_file != "", "Pass the generated upstream receiver 3MF using -D receiver_file");

module cable_hook() {
    // The upstream receiver has 2 x 1 native slots centered on 28 mm pitch,\n    // in a 70 x 42 mm support plate at z>=0.
    // A 0.8 mm overlap fuses the peg into the back, leaving receiver slots
    // in their untouched upstream geometry.
    union() {
        import(receiver_file, convexity=10);
        translate([35, 21, -stem_length_mm])
            cylinder(d=stem_diameter_mm, h=stem_length_mm+0.8);
        translate([35, 21, -stem_length_mm-lip_height_mm])
            cylinder(d1=lip_diameter_mm,d2=stem_diameter_mm,h=lip_height_mm);
    }
}

cable_hook();
